{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "./zephyros.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2,
    },
    "color": {
      "1": "light_white",
      "2": "light_cyan",
      "3": "cyan",
      "4": "light_blue",
      "5": "blue",
    },
  },
  // "display": {
  //   "separator": "  ",
  //   "color": {
  //     "keys": "light_blue",
  //   },
  // },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "color": {
        "user": "light_blue",
        "at": "white",
        "host": "magenta",
      },
    },
    "break",
    {
      "type": "command",
      "key": " 󱋩",
      "text": "/usr/libexec/bazzite-fetch-image",
    },
    {
      "type": "os",
      "key": " 󰣛",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": " ",
      "format": "{1} {2}",
    },
    {
      "type": "uptime",
      "key": " 󰅐",
    },
    "break",
    {
      "type": "host",
      "key": " 󰾰",
    },
    {
      "type": "cpu",
      "key": " 󰻠",
    },
    {
      "type": "gpu",
      "key": " 󰍛",
    },
    {
      "type": "memory",
      "key": " ",
    },
    {
      "type": "disk",
      "key": " ",
      "hideFS": "overlay",
    },
    {
      "type": "display",
      "key": " 󰍹",
    },
    {
      "type": "battery",
      "key": " ",
    },
    {
      "type": "gamepad",
      "key": " 󰖺",
    },
    "break",
    {
      "type": "de",
      "key": " 󰕮",
    },
    {
      "type": "wm",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "terminal",
      "key": " ",
    },
    {
      "type": "packages",
      "key": " 󰏖",
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
